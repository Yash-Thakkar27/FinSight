# Streamlit Community Cloud: paste these keys into the app's Secrets box (App settings ->
# Secrets), with the values for your hosted PostgreSQL database. Root-level secrets are
# exposed to the app as environment variables, which is how config/settings.py reads them.
# For a local run use .env instead; never commit a real secrets.toml.

POSTGRES_HOST = "your-project.region.aws.neon.tech"
POSTGRES_PORT = "5432"
POSTGRES_DB = "finsight"
POSTGRES_USER = "your_user"
POSTGRES_PASSWORD = "your_password"
POSTGRES_SSLMODE = "require"
