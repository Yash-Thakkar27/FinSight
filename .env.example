# Copy to .env and adjust. Used by docker-compose.yml and config/settings.py.
# Host port 5433 avoids clashing with a locally installed PostgreSQL on 5432.
POSTGRES_USER=finsight
POSTGRES_PASSWORD=change_me
POSTGRES_DB=finsight
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# Optional. POSTGRES_SSLMODE=require for a hosted database; leave unset for local Docker.
# POSTGRES_SSLMODE=require
# Optional. A different container name, to run a second copy of the project on one machine.
# POSTGRES_CONTAINER=finsight-db
